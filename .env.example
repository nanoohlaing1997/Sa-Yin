# Firebase web app config — Project settings → Your apps → Web app.
# These values are public by design; Firestore security rules enforce access.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Owner account the app signs in with automatically (no login screen).
# Create it in Firebase console → Authentication → Users → Add user.
EXPO_PUBLIC_OWNER_EMAIL=
EXPO_PUBLIC_OWNER_PASSWORD=
